# ===== SUPABASE (Bắt buộc) =====
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ===== SUPABASE SERVICE ROLE KEY (Bắt buộc cho API backend) =====
# Chỉ dùng ở Server-side (Vercel environment variables), KHÔNG đưa vào client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== GEMINI AI (Tùy chọn - cho tính năng AI) =====
GEMINI_API_KEY=your-gemini-api-key

# ===== APP URL (Tùy chọn) =====
# URL của ứng dụng, dùng cho link tự tham chiếu, OAuth callbacks, API endpoints
APP_URL=http://localhost:5173

# ===== EMAIL (Tùy chọn - SMTP) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ===== SEPAY (Tùy chọn - đối soát thanh toán) =====
VITE_SEPAY_API_KEY=your-sepay-api-key
SEPAY_WEBHOOK_SECRET=your-webhook-secret

# ===== ZALO ZNS (Tùy chọn - thông báo OA) =====
# ZALO_API_BASE_URL=https://business.openapi.zalo.me
# ZALO_OAUTH_BASE_URL=https://oauth.zaloapp.com

# ===== ONESIGNAL (Tùy chọn - push notification) =====
# ONESIGNAL_APP_ID=your-onesignal-app-id
# ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
